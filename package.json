{
  "name": "niuma-grass",
  "version": "1.0.0",
  "private": true,
  "description": "牛马吃草 · 看得见的上班动力",
  "main": "electron/main.cjs",
  "author": "牛马吃草",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/calculator.test.cjs",
    "dist": "electron-builder --win portable --x64",
    "verify:ui": "electron . --smoke-test"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.niuma.grass",
    "productName": "牛马吃草",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "src/**/*", "assets/**/*", "package.json"],
    "win": { "target": "portable", "icon": "assets/icon.ico", "artifactName": "NiumaGrass-${version}-portable.${ext}" },
    "portable": { "requestExecutionLevel": "user" }
  }
}
